{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Hangfire": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/panshi-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ]
  },
  "Db": {
    "ConnectionString": "Host=localhost;Port=5432;Database=panshi;Username=panshi;Password=Panshi@2026;Pooling=true;Maximum Pool Size=50",
    "SnowflakeWorkerId": 1,
    "BackupDir": "backups"
  },
  "Jwt": {
    "SecretKey": "DEV-ONLY-PANSHI-JWT-SECRET-CHANGE-IN-PROD-0123456789",
    "Issuer": "Panshi",
    "Audience": "Panshi.Web",
    "AccessTokenMinutes": 120,
    "RefreshTokenDays": 7
  },
  "Cors": {
    "Origins": [ "http://localhost:5173" ]
  },
  "Security": {
    "TrustedProxies": []
  },
  "Features": {
    "TrustForwardedHeaders": false
  },
  "AllowedHosts": "*"
}
