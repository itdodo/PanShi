# 磐石 Panshi —— 环境变量模板
# 用法：复制为 .env 并填入真实值。`.env` 已被 .gitignore 忽略，切勿提交。
#   cp .env.example .env
#
# docker compose 会自动读取同目录下的 .env 做 ${VAR} 变量替换。

# JWT 签名密钥：至少 32 字符（AuthOptions.Validate 会强制校验），生产必须随机化。
# 生成：openssl rand -hex 32
PANSHI_JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARS_RANDOM_SECRET

# PostgreSQL 超级用户口令（容器首启初始化用；改口令需同步 DB 或重建数据卷）
PANSHI_DB_PASSWORD=Panshi@2026
